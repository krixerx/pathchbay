{
  "description": "Shared linking rules (D-12, R5). Engine (Java) and console (TypeScript) must both pass every case. Paths: a segment ending in [] means each item of that list; a path ending in [] is the list itself. listLinks are the list-to-list links that already exist. reason is null when the link is allowed, otherwise a stable code.",
  "cases": [
    { "name": "simple field to simple field", "source": "title", "target": "body.title", "listLinks": [], "reason": null },
    { "name": "nested object fields", "source": "address.city", "target": "body.ADDRESS.town", "listLinks": [], "reason": null },
    { "name": "list to list at the same level", "source": "addresses[]", "target": "body.ADDRESSES[]", "listLinks": [], "reason": null },
    { "name": "item field before its list is linked", "source": "addresses[].street", "target": "body.ADDRESSES[].line1", "listLinks": [], "reason": "list-not-linked" },
    { "name": "item field after its list is linked", "source": "addresses[].street", "target": "body.ADDRESSES[].line1",
      "listLinks": [["addresses[]", "body.ADDRESSES[]"]], "reason": null },
    { "name": "outer field into every item after the list link", "source": "country", "target": "body.ADDRESSES[].country",
      "listLinks": [["addresses[]", "body.ADDRESSES[]"]], "reason": null },
    { "name": "outer field into an item before the list link", "source": "country", "target": "body.ADDRESSES[].country", "listLinks": [], "reason": "list-not-linked" },
    { "name": "item field into a list linked from another list", "source": "phones[].number", "target": "body.ADDRESSES[].line1",
      "listLinks": [["addresses[]", "body.ADDRESSES[]"], ["phones[]", "body.PHONES[]"]], "reason": "different-list" },
    { "name": "nested list before its outer list is linked", "source": "orders[].lines[]", "target": "body.ORDERS[].LINES[]", "listLinks": [], "reason": "list-not-linked" },
    { "name": "nested list after its outer list is linked", "source": "orders[].lines[]", "target": "body.ORDERS[].LINES[]",
      "listLinks": [["orders[]", "body.ORDERS[]"]], "reason": null },
    { "name": "nested item field with both lists linked", "source": "orders[].lines[].sku", "target": "body.ORDERS[].LINES[].SKU",
      "listLinks": [["orders[]", "body.ORDERS[]"], ["orders[].lines[]", "body.ORDERS[].LINES[]"]], "reason": null },
    { "name": "nested item field with only the outer list linked", "source": "orders[].lines[].sku", "target": "body.ORDERS[].LINES[].SKU",
      "listLinks": [["orders[]", "body.ORDERS[]"]], "reason": "list-not-linked" },
    { "name": "outer item field into nested items", "source": "orders[].customer", "target": "body.ORDERS[].LINES[].CUSTOMER",
      "listLinks": [["orders[]", "body.ORDERS[]"], ["orders[].lines[]", "body.ORDERS[].LINES[]"]], "reason": null },
    { "name": "nested item field upward to a single-level item", "source": "orders[].lines[].sku", "target": "body.ORDERS[].SKU",
      "listLinks": [["orders[]", "body.ORDERS[]"]], "reason": "upward-from-nested-list" },
    { "name": "item field upward to a single value", "source": "addresses[].street", "target": "body.STREET", "listLinks": [], "reason": "upward-from-nested-list" },
    { "name": "list to single value", "source": "addresses[]", "target": "body.ADDRESS", "listLinks": [], "reason": "list-to-single" },
    { "name": "single value to list", "source": "address", "target": "body.ADDRESSES[]", "listLinks": [], "reason": "single-to-list" },
    { "name": "list to a list nested one level deeper", "source": "tags[]", "target": "body.GROUPS[].TAGS[]",
      "listLinks": [["groups[]", "body.GROUPS[]"]], "reason": "list-level-mismatch" },
    { "name": "root list of the response to an output list", "source": "[]", "target": "books[]", "listLinks": [], "reason": null },
    { "name": "field of each root item", "source": "[].title", "target": "books[].title", "listLinks": [["[]", "books[]"]], "reason": null }
  ]
}
