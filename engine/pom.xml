<?xml version="1.0" encoding="UTF-8"?>
<!-- Patchbay engine: walking skeleton (docs/slice-plan.md, Next Step 3). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot version that camel-dependencies 4.23.0 is built against -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>integrationmapper</groupId>
    <artifactId>engine</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Patchbay engine</name>
    <url>https://github.com/krixerx/pathchbay</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <camel.version>4.23.0</camel.version>

        <!-- Security fixes over Spring Boot 4.1.1's versions (Trivy, 2026-11-25). Drop each when a Boot or library
             upgrade brings the same or a newer version. -->
        <tomcat.version>11.0.29</tomcat.version>
        <jackson-bom.version>3.1.9</jackson-bom.version>
        <jackson-2-bom.version>2.21.9</jackson-2-bom.version>
        <!-- Pulled in by datasonnet-mapper (camel-datasonnet) and swagger-core (swagger-parser). -->
        <bouncycastle.version>1.87</bouncycastle.version>
        <guava.version>33.8.0-android</guava.version>
        <!-- Only DataSonnet's multipart plugin uses it, and Patchbay never maps multipart through DataSonnet;
             commons-fileupload2-jakarta has no release after 2.0.0-M1 under that name, so only core moves. -->
        <commons-fileupload2-core.version>2.0.0-M5</commons-fileupload2-core.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpg-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-fileupload2-core</artifactId>
                <version>${commons-fileupload2-core.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.camel.springboot</groupId>
                <artifactId>camel-spring-boot-bom</artifactId>
                <version>${camel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-platform-http-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-http-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-datasonnet-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <!-- Health only: liveness, and readiness once every integration is loaded (Docker HEALTHCHECK, orchestrators) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- JSON <-> XML at the edges of a call (TODO-T4, D-24); Jackson 2, like Json.MAPPER -->
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <!-- OpenAPI 3 parsing; converts Swagger 2.0 on import (D-5) -->
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser</artifactId>
            <version>2.1.48</version>
        </dependency>
        <dependency>
            <!-- XSD of WSDL contracts: imports, includes, named and anonymous types (D-30); Apache-2.0, no runtime dependencies -->
            <groupId>org.apache.ws.xmlschema</groupId>
            <artifactId>xmlschema-core</artifactId>
            <version>2.3.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
