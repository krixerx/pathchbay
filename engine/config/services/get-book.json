{
  "id": "get-book",
  "version": "1.0.0",
  "input": "book-ref",
  "output": "book-details",
  "target": {
    "baseUrl": "https://fakerestapi.azurewebsites.net",
    "method": "GET",
    "path": "/api/v1/Books/{id}"
  },
  "request": {
    "links": [
      { "from": "br-bookId", "to": "path.id" }
    ]
  },
  "response": {
    "links": [
      { "from": "id", "to": "bd-bookId" },
      { "from": "title", "to": "bd-title" },
      { "from": "description", "to": "bd-summary" },
      { "from": "pageCount", "to": "bd-pages" },
      { "from": "publishDate", "to": "bd-published" }
    ]
  }
}
